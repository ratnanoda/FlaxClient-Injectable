#include <windows.h>
#include <winver.h>

#define FLAX_FILE_VERSION 1,0,1,0
#define FLAX_FILE_VERSION_STRING "1.0.1.0\0"

201 RCDATA "@FLAX_CLIENT_DLL_RC@"
1 RT_MANIFEST "@FLAX_INJECTOR_MANIFEST_RC@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FLAX_FILE_VERSION
 PRODUCTVERSION FLAX_FILE_VERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FlaxClient Open Source Project\0"
            VALUE "FileDescription", "FlaxClient Lunar Client 1.8.9 Attach Tool\0"
            VALUE "FileVersion", FLAX_FILE_VERSION_STRING
            VALUE "InternalName", "FlaxClient\0"
            VALUE "LegalCopyright", "Copyright (c) FlaxClient contributors\0"
            VALUE "OriginalFilename", "FlaxClient.exe\0"
            VALUE "ProductName", "FlaxClient\0"
            VALUE "ProductVersion", FLAX_FILE_VERSION_STRING
            VALUE "Comments", "Open-source build from github.com/ratnanoda/FlaxClient-Injectable\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
